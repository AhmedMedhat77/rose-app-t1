{
  "name": "rose-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "check:ci": "npm run check && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.2",
    "@tanstack/react-query": "^5.107.1",
    "@types/web-push": "^3.6.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-international-phone": "^4.8.0",
    "react-phone-input-2": "^2.15.1",
    "react-phone-number-input": "^3.4.18",
    "shadcn": "^4.23.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs,mts,cts})": "prettier --write --ignore-unknown"
  }
}
